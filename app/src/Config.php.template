<?php
declare(strict_types=1);

/**
 * Central configuration. Secrets live here, outside the public webroot.
 * Generated by install.sh from this template - every __TOKEN__ below is
 * substituted with a freshly generated secret or a value detected from the
 * server at install time. This file never gets checked into anything with
 * real secrets in it; only this template does.
 */
final class Config
{
    // App DB (panel's own state: users, packages, domains, etc.)
    public const DB_HOST = '127.0.0.1';
    public const DB_NAME = 'hostpanel';
    public const DB_USER = 'hostpanel_app';
    public const DB_PASS = '__DB_APP_PASS__';

    // Provisioning DB connection: used ONLY to create/drop per-customer
    // databases and MySQL users. Kept separate from the app's own
    // least-privilege connection above.
    public const PROV_DB_HOST = '127.0.0.1';
    public const PROV_DB_USER = 'hostpanel_prov';
    public const PROV_DB_PASS = '__DB_PROV_PASS__';

    // Stalwart Mail (JMAP admin API)
    public const MAIL_API_BASE = 'http://127.0.0.1:8080';
    public const MAIL_ADMIN_USER = '__MAIL_ADMIN_USER__';
    public const MAIL_ADMIN_PASS = '__MAIL_ADMIN_PASS__';

    // SFTPGo REST API
    public const SFTP_API_BASE = 'http://127.0.0.1:8090';
    public const SFTP_ADMIN_USER = 'panelapi';
    public const SFTP_ADMIN_PASS = '__SFTP_ADMIN_PASS__';

    // Server / provisioning paths
    public const SERVER_HOSTNAME = '__SERVER_HOSTNAME__';
    public const SERVER_IP = '__SERVER_IP__';
    public const SERVER_IPV6 = '__SERVER_IPV6__'; // '' when the server has no public IPv6
    public const VHOSTS_DOCROOT_BASE = '/var/www';
    public const VHOSTS_CADDY_DIR = '/var/lib/frankenphp/sites-enabled';
    public const FRANKENPHP_CONFIG = '/etc/frankenphp/Caddyfile';
    public const PHP_VERSIONS_DIR = '/opt/php-versions';

    // cPanel/WHM migrations. APP_KEY encrypts secrets the panel has to keep
    // for a while (source-server credentials of a running migration); it is
    // generated once by install.sh and persisted in /root/.jinnpanel/app_key.
    public const APP_KEY = '__APP_KEY__';
    public const MIGRATION_DIR = '/var/lib/jinnpanel/migrations';
    // Port the source cPanel server uploads backups to in "push" mode (SFTPGo).
    public const SFTP_PUBLIC_PORT = 2022;

    public const APP_NAME = 'JinnPanel';
    public const SESSION_NAME = 'hostpanel_sid';
}
